# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Node (in case you add build tooling later, e.g. icon generation)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# package-lock.json IS tracked: CI uses `npm ci` for reproducible installs.

# Env / secrets
.env
.env.local

# Build output (if you ever add a bundler)
dist/
build/

# Staging dir created by the Pages deploy job
_site/

# Logs
*.log

# Playwright
test-results/
playwright-report/
playwright/.cache/

# Local backup/export files you might drop in the folder while testing
*.backup.html
exercise-app-log-*.json